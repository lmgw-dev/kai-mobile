    <string name="set_timeout">Wait for lmgw</string>
    <string name="set_timeout_help">How long Kai waits for lmgw to connect or answer before it gives up.</string>
    <string name="set_stagger">Pause between addresses</string>
    <string name="set_stagger_help">When lmgw has several addresses, how long Kai waits on one before it tries the next as well.</string>
    <string name="set_retry">Longest pause between retries</string>
    <string name="set_retry_help">When lmgw cannot be reached, Kai retries more and more slowly, up to this pause, while the app is open.</string>
    <string name="set_retry_background">Longest pause between retries in the background</string>
    <string name="set_retry_background_help">The same while the app is not on screen. A longer pause saves battery when lmgw is off for hours.</string>
    <string name="set_keepalive">Keep-alive interval</string>
    <string name="set_keepalive_help">How often lmgw sends a signal on the live connection. Kai notices a lost connection after two missed signals.</string>
    <string name="set_confirm_poll">Pairing check interval</string>
    <string name="set_confirm_poll_help">While you confirm this phone on your computer, how often Kai checks whether you have.</string>
    <string name="set_voice_turns">Speaking turns</string>
    <string name="set_voice_turns_help">Who decides when you speak and when Kai answers.</string>
    <string name="voice_mode_thread">Follow the conversation</string>
    <string name="voice_mode_thread_help">Use the mode lmgw reports for the conversation, automatic or push-to-talk.</string>
    <string name="voice_mode_automatic">Always automatic</string>
    <string name="voice_mode_automatic_help">Kai listens throughout and answers when you pause.</string>
    <string name="voice_mode_ptt">Always push-to-talk</string>
    <string name="voice_mode_ptt_help">Kai listens only while you press and hold.</string>
    <string name="set_voice_output">Output</string>
    <string name="set_voice_output_help">Where Kai\'s voice plays when no headset is connected.</string>
    <string name="voice_route_speaker">Speaker</string>
    <string name="voice_route_earpiece">Earpiece</string>
    <string name="set_voice_echo">Echo cancelling</string>
    <string name="voice_echo_note">If Kai interrupts itself on the speaker, try software echo cancelling, or half duplex if that is not enough. A change applies from the next call.</string>
    <string name="voice_echo_auto">Automatic</string>
    <string name="voice_echo_auto_help">The phone\'s own canceller where it has one, otherwise Kai\'s software.</string>
    <string name="voice_echo_hardware">Phone\'s own canceller</string>
    <string name="voice_echo_hardware_help">Use the canceller built into the phone.</string>
    <string name="voice_echo_software">Software</string>
    <string name="voice_echo_software_help">Kai\'s own canceller (WebRTC).</string>
    <string name="voice_echo_half_duplex">Half duplex</string>
    <string name="voice_echo_half_duplex_help">Kai does not hear you while it speaks, and speech does not interrupt it: tap the ring to stop it.</string>
    <string name="set_voice_cues">Sounds and vibration</string>
    <string name="set_earcon">Listening sound</string>
    <string name="set_earcon_help">A short sound when Kai starts listening and when a call ends.</string>
    <string name="set_haptics">Vibration</string>
    <string name="set_haptics_help">A tick when Kai starts listening and when you press and release push-to-talk.</string>
    <string name="set_connect">Time to start a call</string>
    <string name="set_connect_help">How long Kai waits for lmgw\'s first word after you start a call.</string>
    <string name="set_idle">End a quiet call after</string>
    <string name="set_idle_help">A call ends after this much silence. 0 keeps it going until you end it.</string>
    <string name="set_report">Speech progress updates</string>
    <string name="set_report_help">How often Kai tells lmgw how much of its speech has played. Keep it well below lmgw\'s realtime ping interval, which you set in the dashboard.</string>
    <string name="set_ptt_tail">Push-to-talk tail</string>
    <string name="set_ptt_tail_help">How long the microphone stays on after you let go. Leave it empty for no tail. It must fit inside lmgw\'s commit window (120 ms unless you changed it in the dashboard): a longer tail needs that window raised, or the last syllable is lost.</string>
    <string name="set_echo_tail">Half-duplex echo tail</string>
    <string name="set_echo_tail_help">Only for half duplex: how long after Kai stops speaking the microphone still counts as its echo. Leave it empty to use lmgw\'s own value.</string>
